# Matchday — environment variable template.
#
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Variable NAMES only are listed here; no credentials belong in this file.
#
# ---------------------------------------------------------------------------
# Browser-visible (safe to expose). Anything prefixed NEXT_PUBLIC_ is inlined
# into the client bundle, so it must never hold a secret.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. http://127.0.0.1:54321 locally.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/publishable key. Safe for the browser; RLS is what
# actually protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin used to build the magic-link / OTP redirect URL,
# e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# VAPID public key for Web Push. Browser-visible by design: it is the
# application server key a browser needs in order to create a subscription, and
# it authorises nothing on its own. Pairs with VAPID_PRIVATE_KEY below.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Where a blocked user can reach a human, e.g. support@yourdomain.example.
#
# Optional but strongly recommended before a pilot: unset, the footer and both
# error boundaries simply show nothing, and somebody who cannot sign in has no
# route out of the product. Deliberately not defaulted to any address — the
# first pilot league is a tenant, not the product, and a hard-coded club mailbox
# would receive another league's mail as soon as a second one signs up.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Server-only secrets. These MUST NOT be prefixed with NEXT_PUBLIC_ and must
# never be imported into a client component.
# ---------------------------------------------------------------------------

# Supabase service-role key. Bypasses Row Level Security. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# VAPID private key for Web Push. Server-only, and deliberately NOT prefixed
# with NEXT_PUBLIC_ — it is the signing key that authorises pushes to every
# subscribed device. Generate a pair with `npx web-push generate-vapid-keys`.
VAPID_PRIVATE_KEY=

# Contact for the push service, as `mailto:someone@example.com`. Required by
# the Web Push protocol so a push provider can reach the operator.
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# APNs, for the native iOS app. Six variables, because Apple's key model is
# environment-specific and its current guidance is to hold separate Sandbox and
# Production keys.
#
# Unset, nothing breaks: iOS app devices are skipped, nothing is recorded
# against them, and configuring these later starts delivery with no backlog of
# permanently-failed rows. One environment configured and not the other is also
# a valid state — only that environment's devices are skipped.
#
# An operator holding a legacy key that works in both environments configures
# the same Key ID and the same .p8 in both pairs. That is supported.

# The ten-character Team ID, and the app's bundle identifier. Together they
# build the `iss` claim and the `apns-topic` header. Neither is a secret; both
# are required.
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# Sandbox: for builds installed from Xcode. Key ID is the ten-character
# identifier from Apple Developer → Keys.
APNS_SANDBOX_KEY_ID=

# Contents of the sandbox .p8, including the BEGIN/END lines. Server-only,
# deliberately NOT prefixed with NEXT_PUBLIC_ — anyone holding it can send a
# notification to any MatchDay device in that environment. Apple lets a .p8 be
# downloaded exactly once, so keep the original somewhere safe. Newlines may be
# escaped as \n if the secret store cannot hold them.
APNS_SANDBOX_PRIVATE_KEY=

# Production: for TestFlight and App Store builds. Same shape as above.
APNS_PRODUCTION_KEY_ID=
APNS_PRODUCTION_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Test-only. Optional. Point the database test suite at an existing Postgres
# instance (for example a running `supabase start`) instead of letting the
# harness boot its own throwaway PostgreSQL server.
# ---------------------------------------------------------------------------

# e.g. postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Reminder scheduling (Phase 5). Server-only.
# ---------------------------------------------------------------------------

# Shared secret the production scheduler presents to POST /api/cron/reminders
# as `Authorization: Bearer <secret>`. Without it that route answers 404, so an
# unprotected trigger cannot flush a league's reminders early.
#
# NOTHING IN THIS REPOSITORY RUNS THE SCHEDULE. Configure a Vercel Cron entry or
# a Supabase pg_cron job to call the route every few minutes, or reminders never
# go out. See NEXT_STEPS.md.
CRON_SECRET=

# Better Stack (or any compatible) heartbeat URL, pinged after every reminder
# cron run. Server-only, and a CREDENTIAL: anyone holding it can report this job
# as healthy, so it is never logged and never returned in a response.
#
# Optional. Unset — locally, in tests and on Preview — the cron behaves exactly
# as before and simply logs `heartbeat.skipped`. Set it in Production, because
# `reminder.run`'s absence is the signal that the scheduler has stopped and a
# deployment that has stopped running crons cannot notice its own silence.
#
# The base URL reports success; the same URL with `/fail` appended reports a
# failed run. Both are sent as a bare GET with no body.
REMINDER_HEARTBEAT_URL=

# ── Email notifications (Phase 3D) ──────────────────────────────────────────
#
# Both are server-only and both are optional: with either unset the email
# channel is simply not available, and push delivery is unaffected. Nothing
# reads them at startup, so a deployment without email starts and serves
# exactly as before.
#
# The sending domain in EMAIL_FROM must be verified with the provider before
# anything will be accepted. See docs/operations/production.md.
RESEND_API_KEY=
EMAIL_FROM=
