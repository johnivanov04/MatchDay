# Matchday — environment variable template.
#
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Variable NAMES only are listed here; no credentials belong in this file.
#
# ---------------------------------------------------------------------------
# Browser-visible (safe to expose). Anything prefixed NEXT_PUBLIC_ is inlined
# into the client bundle, so it must never hold a secret.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. http://127.0.0.1:54321 locally.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/publishable key. Safe for the browser; RLS is what
# actually protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin used to build the magic-link / OTP redirect URL,
# e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# VAPID public key for Web Push. Browser-visible by design: it is the
# application server key a browser needs in order to create a subscription, and
# it authorises nothing on its own. Pairs with VAPID_PRIVATE_KEY below.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets. These MUST NOT be prefixed with NEXT_PUBLIC_ and must
# never be imported into a client component.
# ---------------------------------------------------------------------------

# Supabase service-role key. Bypasses Row Level Security. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# VAPID private key for Web Push. Server-only, and deliberately NOT prefixed
# with NEXT_PUBLIC_ — it is the signing key that authorises pushes to every
# subscribed device. Generate a pair with `npx web-push generate-vapid-keys`.
VAPID_PRIVATE_KEY=

# Contact for the push service, as `mailto:someone@example.com`. Required by
# the Web Push protocol so a push provider can reach the operator.
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# Test-only. Optional. Point the database test suite at an existing Postgres
# instance (for example a running `supabase start`) instead of letting the
# harness boot its own throwaway PostgreSQL server.
# ---------------------------------------------------------------------------

# e.g. postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Reminder scheduling (Phase 5). Server-only.
# ---------------------------------------------------------------------------

# Shared secret the production scheduler presents to POST /api/cron/reminders
# as `Authorization: Bearer <secret>`. Without it that route answers 404, so an
# unprotected trigger cannot flush a league's reminders early.
#
# NOTHING IN THIS REPOSITORY RUNS THE SCHEDULE. Configure a Vercel Cron entry or
# a Supabase pg_cron job to call the route every few minutes, or reminders never
# go out. See NEXT_STEPS.md.
CRON_SECRET=
