# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage
/test-results

# local database artefacts (embedded Postgres data directories)
/.tmp/
/supabase/.branches
/supabase/.temp

# environment — never commit real credentials
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# APNs signing keys. Apple lets a .p8 be downloaded exactly once and anyone
# holding one can send a notification to every device the app is installed on,
# so the file belongs in a secret store and never in a repository. Ignored by
# extension rather than by name: the filename carries the Key ID and would
# differ for every key.
*.p8

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# vercel
.vercel

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
