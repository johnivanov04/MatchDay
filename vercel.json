{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/account-deletion",
      "schedule": "17 * * * *"
    }
  ]
}
