{
  "name": "matchday",
  "version": "0.1.0",
  "private": true,
  "description": "Matchday — multi-league pickup-sports web application (Phase 1 foundation)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:diff": "supabase db diff"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.0",
    "eslint-config-next": "16.3.0",
    "pg": "8.22.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
